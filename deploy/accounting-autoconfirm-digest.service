[Unit]
Description=Accounting weekly auto-confirm digest — trailing 7-day auto:rule confirms, grouped by vendor (REQ-MCA-003)
After=network-online.target
Wants=network-online.target
OnFailure=accounting-alert@%p.service

[Service]
Type=oneshot
User=travis
Group=travis
WorkingDirectory=/home/travis/accounting
EnvironmentFile=/etc/accounting/doppler.env
Environment=DOPPLER_CONFIG_DIR=/home/travis/accounting/data/.doppler
Environment=XDG_CONFIG_HOME=/home/travis/accounting/data/.xdg
Environment=XDG_CACHE_HOME=/home/travis/accounting/data/.cache
# Doppler config is selected by the service token in /etc/accounting/doppler.env
# (scoped to accounting/srv) — no --config flag needed. Requires RESEND_API_KEY +
# ALERT_TO_EMAIL in accounting/srv.
# GATED: install the timer, run one DRY-RUN by hand first
#   doppler run -- env -u DOPPLER_TOKEN /home/travis/accounting/.venv/bin/python -m scripts.autoconfirm digest
# then flip to --apply below after one clean cycle.
ExecStart=/usr/bin/doppler run -- /usr/bin/env -u DOPPLER_TOKEN /home/travis/accounting/.venv/bin/python -m scripts.autoconfirm digest --apply
TimeoutStartSec=120
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/travis/accounting/data
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
SystemCallFilter=@system-service
# Activated by accounting-autoconfirm-digest.timer — not enabled directly (no [Install]).
