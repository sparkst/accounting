[Unit]
Description=Accounting EA alert dispatch — daily WA B&O tax + invoice reminders via n8n
After=network-online.target
Wants=network-online.target
OnFailure=accounting-alert-webhook@%p.service

[Service]
Type=oneshot
User=travis
Group=travis
WorkingDirectory=/home/travis/accounting
EnvironmentFile=/etc/accounting/doppler.env
Environment=DOPPLER_CONFIG_DIR=/home/travis/accounting/data/.doppler
Environment=XDG_CONFIG_HOME=/home/travis/accounting/data/.xdg
Environment=XDG_CACHE_HOME=/home/travis/accounting/data/.cache
# Doppler config is selected by the service token in /etc/accounting/doppler.env
# (scoped to accounting/srv) — no --config flag needed.
# Drop --apply to run DRY-RUN (no n8n POST, no DB writes).
ExecStart=/usr/bin/doppler run -- /usr/bin/env -u DOPPLER_TOKEN /home/travis/accounting/.venv/bin/python -m scripts.alerts_dispatch --apply
TimeoutStartSec=120
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/travis/accounting/data
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
SystemCallFilter=@system-service
# Activated by accounting-ea-alerts.timer — not enabled directly (no [Install]).
