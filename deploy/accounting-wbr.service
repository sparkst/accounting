[Unit]
Description=Accounting Weekly Business Review scorecard — Resend email (REQ-WBR-001..003)
After=network-online.target
Wants=network-online.target
OnFailure=accounting-alert-webhook@%p.service

[Service]
Type=oneshot
User=travis
Group=travis
WorkingDirectory=/home/travis/accounting
EnvironmentFile=/etc/accounting/doppler.env
Environment=DOPPLER_CONFIG_DIR=/home/travis/accounting/data/.doppler
Environment=XDG_CONFIG_HOME=/home/travis/accounting/data/.xdg
Environment=XDG_CACHE_HOME=/home/travis/accounting/data/.cache
# Doppler config is selected by the service token in /etc/accounting/doppler.env
# (scoped to accounting/srv) — no --config flag needed. Requires RESEND_API_KEY
# and (optionally) REPORT_TO_EMAIL in accounting/srv.
# Drop --apply to run DRY-RUN (prints the rendered report, no send, no ledger write).
ExecStart=/usr/bin/doppler run -- /usr/bin/env -u DOPPLER_TOKEN /home/travis/accounting/.venv/bin/python -m scripts.wbr_dispatch --apply
TimeoutStartSec=120
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/travis/accounting/data
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
SystemCallFilter=@system-service
# Activated by accounting-wbr.timer — not enabled directly (no [Install]).
# Rollout: manual `--apply` smoke on box before `systemctl enable` the timer.
