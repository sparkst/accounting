[Unit]
Description=Daily Plaid transactions sync (--apply) — ingests register transactions via /transactions/sync (register-scope Items: Amex + Chase)
OnFailure=accounting-alert@%p.service

[Service]
Type=oneshot
User=travis
Group=travis
WorkingDirectory=/home/travis/accounting
EnvironmentFile=/etc/accounting/doppler.env
Environment=DOPPLER_CONFIG_DIR=/home/travis/accounting/data/.doppler
Environment=XDG_CONFIG_HOME=/home/travis/accounting/data/.xdg
Environment=XDG_CACHE_HOME=/home/travis/accounting/data/.cache
ExecStart=/usr/bin/doppler run -- /usr/bin/env -u DOPPLER_TOKEN /home/travis/accounting/.venv/bin/python3 -m scripts.plaid_transactions_sync --apply
TimeoutStartSec=600
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/travis/accounting/data
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
SystemCallFilter=@system-service
# Activated by plaid-transactions-sync.timer. Exits non-zero if ANY Item errors
# (e.g. ITEM_LOGIN_REQUIRED) or a cursor is held, tripping the OnFailure alert.
# Wealth-scope Items never enter this sync (REQ-PC-B1).
